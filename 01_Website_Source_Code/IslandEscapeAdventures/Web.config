<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <connectionStrings>
    <!--
      Change "YourServerName" to your SQL Server instance name.
      Common values: localhost, .\SQLEXPRESS, (localdb)\MSSQLLocalDB
    -->
    <add name="IslandEscapeDB"
         connectionString="Data Source=localhost;Initial Catalog=IslandEscapeDB;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />

    <!-- Custom error page -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />

    <!-- Session timeout: 30 minutes -->
    <sessionState timeout="30" />

    <!-- Forms authentication - default deny for protected pages handled per-folder -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="30" />
    </authentication>

    <!-- ASP.NET Membership and Role providers backed by the IslandEscapeDB Users table -->
    <membership defaultProvider="IslandEscapeMembershipProvider">
      <providers>
        <clear />
        <add name="IslandEscapeMembershipProvider"
             type="IslandEscapeMembershipProvider"
             applicationName="IslandEscapeAdventures" />
      </providers>
    </membership>

    <roleManager enabled="true"
                 defaultProvider="IslandEscapeRoleProvider"
                 cacheRolesInCookie="true"
                 cookieName=".IslandEscapeRoles"
                 cookieTimeout="30">
      <providers>
        <clear />
        <add name="IslandEscapeRoleProvider"
             type="IslandEscapeRoleProvider"
             applicationName="IslandEscapeAdventures" />
      </providers>
    </roleManager>

    <!-- By default allow all users on the public site -->
    <authorization>
      <allow users="*" />
    </authorization>
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>
