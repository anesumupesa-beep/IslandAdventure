<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- Deny all anonymous users from the Admin folder.
         The Admin.master.cs code-behind also checks IsAdmin() as a second layer. -->
    <authorization>
      <allow roles="Admin" />
      <deny users="*" />
    </authorization>
  </system.web>
</configuration>
